{
  "extraKnownMarketplaces": {
    "embla-claude-plugins": {
      "source": {
        "source": "git",
        "url": "https://bitbucket.org/emblaftdev/embla-claude-plugins.git"
      }
    }
  },
  "enabledPlugins": {
    "atlassian@claude-plugins-official": true,
    "embla-core@embla-claude-plugins": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git checkout*)",
      "Bash(git worktree*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git pull*)",
      "Bash(git diff*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "cd c:/projects/claudeproject/ai-development-pulina && npx tsc --noEmit && npm test",
            "timeout": 60000,
            "statusMessage": "Running TypeScript + tests before commit..."
          }
        ]
      }
    ]
  }
}
